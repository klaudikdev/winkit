      "category": "developer",
      "title": "Start the OpenSSH agent automatically",
      "description": "Runs the Windows OpenSSH agent so keys added with ssh-add are remembered, even across restarts. Git uses it only when configured to use Windows OpenSSH (core.sshCommand).",
      "risk": "low",
      "restart": "none",
      "actions": [
        { "type": "service", "name": "ssh-agent", "startup": "Automatic", "defaultStartup": "Disabled" }
      ]
    },
    {
      "id": "developer.wsl",
      "category": "developer",
      "title": "Enable Windows Subsystem for Linux",
      "description": "Turns on the WSL and Virtual Machine Platform features. After restarting, install a distribution (for example with the Install Ubuntu button) to start using Linux. Virtual Machine Platform can slow down other hypervisors such as older VirtualBox versions.",
      "risk": "low",
      "restart": "reboot",
      "actions": [
        { "type": "feature", "name": "Microsoft-Windows-Subsystem-Linux", "state": "Enabled", "defaultState": "Disabled" },
        { "type": "feature", "name": "VirtualMachinePlatform", "state": "Enabled", "defaultState": "Disabled" }
      ]
    },
    {
      "id": "developer.sandbox",
      "category": "developer",
      "title": "Enable Windows Sandbox",
      "description": "A disposable desktop for testing untrusted software. Available on Pro, Enterprise and Education editions with virtualization turned on in the firmware.",
      "risk": "low",
      "restart": "reboot",
      "actions": [
        { "type": "feature", "name": "Containers-DisposableClientVM", "state": "Enabled", "defaultState": "Disabled" }
      ]
    },
    {
      "id": "developer.hyper-v",
      "category": "developer",
      "title": "Enable Hyper-V",
      "description": "Microsoft's hypervisor for running full virtual machines. Available on Pro, Enterprise and Education editions. Older VirtualBox or VMware versions and some game anti-cheat software may stop working or run slower.",
      "risk": "medium",
      "restart": "reboot",
      "actions": [
        { "type": "feature", "name": "Microsoft-Hyper-V-All", "state": "Enabled", "defaultState": "Disabled" }
      ]
    },
    {
      "id": "security.autoplay",
      "category": "security",
      "title": "Disable AutoPlay",
      "description": "Nothing runs or opens automatically when you connect a USB drive, memory card or phone.",
      "risk": "low",
      "restart": "none",
      "actions": [
        { "type": "registry", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\AutoplayHandlers", "name": "DisableAutoplay", "kind": "DWord", "value": 1, "defaultValue": 0 }
      ]
    },
    {
      "id": "security.remote-assistance",
      "category": "security",
      "title": "Disable Remote Assistance",
      "description": "Nobody can be invited to view or control this PC through Remote Assistance. Remote Desktop is not affected.",
      "risk": "low",
      "restart": "none",
      "server": false,
      "actions": [
        { "type": "registry", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Remote Assistance", "name": "fAllowToGetHelp", "kind": "DWord", "value": 0, "defaultValue": 1 }
      ]
    }
  ]
}
